# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/verdict

# ── Google AI Studio / Gemini (default AI provider) ───────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase (storage + keepalive) ────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_STORAGE_BUCKET=verdict-screenshots

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Full URL of the deployed frontend — no trailing slash.
# In production this MUST be set to prevent open CORS.
FRONTEND_URL=http://localhost:3000

# ── Cookie signing ────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 32
COOKIE_SECRET=change_me_to_a_random_secret_in_production

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Free-tier audit cap per IP+cookie per 24-hour window.
# Keep in sync with VITE_MAX_FREE_AUDITS in frontend/.env
RATE_LIMIT_FREE_AUDITS_PER_DAY=3

# BYOK (Bring Your Own Key) audit cap per IP+cookie per 24-hour window.
BYOK_RATE_LIMIT_PER_DAY=20

# Global default-path (Gemini) audit cap per UTC day.
GLOBAL_DAILY_AUDITS=150

# Maximum number of pending jobs in the queue before returning 503.
MAX_PENDING_JOBS=10
